{
  "name": "forma-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "web": "expo start --web --port 8082",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "sources": "node scripts/generate-sources.mjs && node scripts/generate-props.mjs",
    "props": "node scripts/generate-props.mjs",
    "build:web": "npm run sources && expo export --platform web",
    "prestart": "npm run sources",
    "preweb": "npm run sources",
    "format": "prettier --write App.tsx components blocks showcase/Examples.tsx showcase/BlockExamples.tsx showcase/registry.ts showcase/blockRegistry.ts scripts index.ts"
  },
  "dependencies": {
    "expo": "~57.0.28",
    "expo-clipboard": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
